<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.linkedinclone</groupId>
    <artifactId>linkedin-clone-microservices</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>linkedin-clone-microservices</name>
    <description>Parent POM for the LinkedIn-clone Spring Boot microservices scaffold</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.4</spring-boot.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
    </properties>

    <!-- Every module inherits Spring Boot + Spring Cloud dependency management -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Build order (Maven resolves this automatically via reactor, but conceptually
        bring these up in this order when running locally):
        1. discovery-server   (must be UP first, everything registers with it)
        2. api-gateway
        3. auth-service
        4. profile-service
        5. connection-service
        6. feed-service
        7. social-service
        8. messaging-service
        9. notification-service
        10. search-service
        Also needed but external to this repo: Kafka + Zookeeper, Redis, Postgres (one DB per service), Elasticsearch.
        See /docker-infra-README.md for a suggested docker-compose for all of the above.
    -->
    <modules>
        <module>discovery-server</module>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>profile-service</module>
        <module>connection-service</module>
        <module>feed-service</module>
        <module>social-service</module>
        <module>messaging-service</module>
        <module>notification-service</module>
        <module>search-service</module>
    </modules>
</project>
